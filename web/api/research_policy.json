    "RESEARCHING",
    "WATCH",
    "RESEARCH_CANDIDATE",
    "INVALIDATED",
    "EXPIRED",
    "EVALUATED"
  ],
  "capability_flags": [
    "DATA_BLOCKED",
    "MODEL_UNVALIDATED",
    "PERSONAL_SIZING_UNASSESSED"
  ],
  "proposed_defaults": {
    "not_manager_rules": true,
    "require_validation": true,
    "stock_quote_max_age_seconds_open_session": 15,
    "option_quote_max_age_seconds_open_session": 30,
    "option_spread_review_if_fraction_of_mid_exceeds": 0.1,
    "option_spread_review_if_absolute_dollars_exceeds": 0.2,
    "delta_comparison_range": [
      0.35,
      0.65
