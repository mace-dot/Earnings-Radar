    "days_to_expiry_comparison_range": [
      14,
      60
    ],
    "zero_day_options_eligible": false,
    "event_expiry_buffer": "strategy_and_event_specific_not_fixed_universal"
  },
  "contract_vetoes": [
    "instrument_identity_unresolved",
    "usage_entitlement_unverified",
    "indicative_only_feed",
    "stale_quote",
    "crossed_quote",
    "missing_contract_multiplier",
    "unsupported_adjusted_contract",
    "unknown_catalyst_timing_for_event_strategy",
    "financial_period_mismatch",
    "missing_executable_quote"
  ],
  "probability_gate": {
    "requires": [
      "approved_model_version",
      "point_in_time_evaluation",
      "horizon_and_universe_match",
      "calibration_report",
      "uncertainty_estimate"
    ],
    "forbidden_proxies": [
      "agent_vote",
      "indicator_count",
      "option_delta_as_profit_probability",
      "risk_neutral_as_real_world"
    ]
  },
  "position_sizing": {
    "approved_budget_required": true,
    "unknown_portfolio_is_not_empty_portfolio": true,
    "default_without_context": "one_contract_premium_exposure_only_no_quantity_advice"
