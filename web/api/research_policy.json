    "open_interest": "explicit_as_of_date",
    "chart": "display_only_not_backend_input"
  },
  "audit_required_fields": [
    "decision_id",
    "as_of",
    "instrument_id",
    "strategy_version",
    "observation_ids",
    "feature_versions",
    "supporting_claim_ids",
    "counterevidence_ids",
    "missing_reasons",
    "eligibility_results",
    "invalidation_rules",
    "next_review_trigger"
  ],
  "promotion": {
    "self_promotion_allowed": false,
    "untouched_evaluation_required": true,
    "contract_backtest_requires_contract_data": true
  },
  "side_effects": {
    "external_notifications": "explicit_opt_in",
    "trade_execution": "disabled",
    "deployment": "separate_implementation_scope"
  }
