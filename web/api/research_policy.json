{
  "schema_version": "planning-1.0",
  "status": "PROPOSED_NOT_ACTIVE",
  "scope": {
    "asset_universe": "initially_liquid_US_common_equities",
    "instruments": [
      "long_call",
      "long_put"
    ],
    "broker_execution": false,
    "paid_services_enabled": false
  },
  "decision_dimensions": [
