# Local-only secrets. Copy to .env and fill in when adding live-data integrations.
# Never commit .env or real API keys.

# Example placeholders for a future market-data provider:
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Optional app overrides:
# EARNINGS_RADAR_DB_PATH=data/earnings_radar.db
# STALE_QUOTE_HOURS=24
# WIDE_SPREAD_PCT=15
