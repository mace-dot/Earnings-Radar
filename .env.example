# Local-only secrets. Copy to .env and fill in when adding live-data integrations.
# Never commit .env or real API keys.

# Example placeholders for a future market-data provider:
# POLYGON_API_KEY=
# FINNHUB_API_KEY=
# ALPHA_VANTAGE_API_KEY=

# Optional app overrides:
# EARNINGS_RADAR_DB_PATH=data/earnings_radar.db
# STALE_QUOTE_HOURS=24
# WIDE_SPREAD_PCT=15

# Autonomous research (real values belong in ignored .env or environment settings)
RADAR_RESEARCH_DB_PATH=data/research.db
RADAR_WATCHLIST=AAPL,MSFT,NVDA
SEC_USER_AGENT=
# RADAR_CIK_MAP={"AAPL":"0000320193"}
# Legacy Streamlit adapter only; not required by the Next.js master engine.
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
ANTHROPIC_API_KEY=
RADAR_MODEL_ENABLED=false
RADAR_MODEL=claude-sonnet-4-5
RADAR_MODEL_DAILY_BUDGET_USD=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RADAR_TELEGRAM_ENABLED=false
RADAR_TELEGRAM_DESTINATION_VERIFIED=false
RADAR_NOTIFY_SEVERITY=high
RADAR_QUIET_START=22
RADAR_QUIET_END=8
RADAR_URGENT_QUIET_EXCEPTION=false
LIVE_QUOTE_MAX_AGE_SECONDS=60
QUOTE_SYNC_TOLERANCE_SECONDS=5

# Hosted dashboard only: enter a strong password securely in hosting settings.
RADAR_REQUIRE_AUTH=false
RADAR_DASHBOARD_PASSWORD=
# Optional persistent export path:
# EARNINGS_RADAR_EXPORTS_DIR=/var/lib/earnings-radar/exports

# Master engine: existing keys can be reused, never send values in chat.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FINNHUB_API_KEY=
# Engine also accepts the existing FINNHUB / FINN_HUB binding names.
ALPHAVANTAGE_API_KEY=
# Optional future adapters, not required to render cached research:
FMP_API_KEY=
TRADIER_API_KEY=
ORATS_API_KEY=
GROQ_API_KEY=
PAPER_MODE=true

# Default master providers: Nasdaq daily history and Cboe delayed option snapshots
# require no API key. Finnhub supplies quotes and news with the key above.
# Delayed snapshots are research references, not executable option quotes.
